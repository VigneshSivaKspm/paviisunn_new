# PaviiSunn Nodemailer Server Configuration
PORT=5000

# Recipient Email for Contact Enquiries
CONTACT_EMAIL_TO=info@paviisunn.in

# Option A: Gmail SMTP Configuration
# 1. Enable 2-Step Verification in Google Account
# 2. Generate an "App Password" under Google Account -> Security -> App Passwords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-digit-app-password
# SMTP_FROM="PaviiSunn Solar" <your-email@gmail.com>

# Option B: Custom Webmail / cPanel / Titan SMTP Configuration
# SMTP_HOST=mail.paviisunn.in
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=info@paviisunn.in
# SMTP_PASS=your_email_password
# SMTP_FROM="PaviiSunn Solar" <info@paviisunn.in>

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PaviiSunn Solar" <info@paviisunn.in>
DISABLE_AUTO_REPLY=false
